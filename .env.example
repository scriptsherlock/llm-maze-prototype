# Choose "openai", "venice", or "gemini".
LLM_PROVIDER=gemini

# OpenAI provider.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4.1-mini

# Venice provider. Venice credits work through the Venice API, not the OpenAI API.
VENICE_API_KEY=your-venice-key-here
VENICE_MODEL=zai-org-glm-5-1

# Gemini provider. Gemini keys work through Google's Gemini API, not OpenAI.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

PORT=3000
