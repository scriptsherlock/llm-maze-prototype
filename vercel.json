{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "installCommand": "npm install --omit=dev",
  "build": { "env": { "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1" } },
  "functions": {
    "api/route-eval-batch.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/participant", "destination": "/index.html" },
    { "source": "/moderator", "destination": "/index.html" },
    { "source": "/original/participant", "destination": "/index.html" },
    { "source": "/original/moderator", "destination": "/index.html" },
    { "source": "/disappear/participant", "destination": "/index.html" },
    { "source": "/disappear/moderator", "destination": "/index.html" },
    { "source": "/looped/participant", "destination": "/index.html" },
    { "source": "/looped/moderator", "destination": "/index.html" }
  ]
}
