{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "installCommand": "npm install --omit=dev",
  "build": { "env": { "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1" } },
  "functions": {
    "api/route-eval-batch.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/participant", "destination": "/index.html" },
    { "source": "/moderator", "destination": "/index.html" },
    { "source": "/original/participant", "destination": "/index.html" },
    { "source": "/original/moderator", "destination": "/index.html" },
    { "source": "/disappear/participant", "destination": "/index.html" },
    { "source": "/disappear/moderator", "destination": "/index.html" },
    { "source": "/ai-maze/participant", "destination": "/index.html" },
    { "source": "/ai-maze/moderator", "destination": "/index.html" },
    { "source": "/study/participant", "destination": "/index.html" },
    { "source": "/study/moderator", "destination": "/index.html" },
    { "source": "/maze-a/participant", "destination": "/index.html" },
    { "source": "/maze-a/moderator", "destination": "/index.html" },
    { "source": "/maze-b/participant", "destination": "/index.html" },
    { "source": "/maze-b/moderator", "destination": "/index.html" },
    { "source": "/maze-c/participant", "destination": "/index.html" },
    { "source": "/maze-c/moderator", "destination": "/index.html" },
    { "source": "/maze-d/participant", "destination": "/index.html" },
    { "source": "/maze-d/moderator", "destination": "/index.html" },
    { "source": "/no-ai-maze/participant", "destination": "/index.html" },
    { "source": "/no-ai-maze/moderator", "destination": "/index.html" }
  ]
}
